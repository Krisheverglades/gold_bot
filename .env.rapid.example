OANDA_API_TOKEN=your-token-here
OANDA_ACCOUNT_ID=your-rapid-strategy-account-id-here
OANDA_ENV=practice
DATA_DIR=/app/data

# Strategy 2 - Rapid Scalper (paper locked by default)
RAPID_MODE=paper
RAPID_GRANULARITY=S5
RAPID_POLL_SECONDS=2
RAPID_PAPER_BALANCE=1000
RAPID_UNITS=1
RAPID_LOOKBACK=3
RAPID_MOMENTUM=0.50
RAPID_MAX_POSITIONS=5
RAPID_SPACING=0.25
RAPID_BASKET_TP=5
RAPID_BASKET_SL=5
RAPID_MAX_DRAWDOWN=0.10
RAPID_SPREAD=0.15
RAPID_COOLDOWN_BARS=1
